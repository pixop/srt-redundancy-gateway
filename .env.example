# -----------------------------------------------------------------------------
# Input failover gateway
# -----------------------------------------------------------------------------
# Input gateway SRT flags.
# Use INPUT_SRT_SOURCE_COMMON_FLAGS for shared primary/backup listener settings,
# then optionally override each leg separately with *_EXTRA_FLAGS.
# Encryption example:
# INPUT_SRT_SOURCE_COMMON_FLAGS=--multiple --transtype live --messageapi --passphrase input-secret --pbkeylen 16
INPUT_SRT_SOURCE_COMMON_FLAGS=--multiple --transtype live --messageapi
INPUT_SRT_PRIMARY_EXTRA_FLAGS=
INPUT_SRT_BACKUP_EXTRA_FLAGS=
INPUT_SRT_OUTPUT_EXTRA_FLAGS=--multiple --transtype live --messageapi
PRIMARY_LISTEN_PORT=5000
BACKUP_LISTEN_PORT=5010
INPUT_FAILOVER_OUTPUT_LISTEN_PORT=6000
INPUT_FAILOVER_RECEIVE_TIMEOUT_MS=2000
INPUT_FAILOVER_VERBOSE=1
INPUT_EVENT_UDP_HOST=127.0.0.1
INPUT_EVENT_UDP_PORT=5557
INPUT_EVENT_USER_DATA=input-failover
INPUT_SRT_STATS_INTERVAL_MS=5000

# -----------------------------------------------------------------------------
# Output failover gateway
# -----------------------------------------------------------------------------
# Node-specific encryption example:
# OUTPUT_SRT_NODE_A_EXTRA_FLAGS=--passphrase node-a-secret --pbkeylen 16
# OUTPUT_SRT_NODE_B_EXTRA_FLAGS=--passphrase node-b-secret --pbkeylen 16
OUTPUT_SRT_SOURCE_COMMON_FLAGS=--multiple --transtype live --messageapi
OUTPUT_SRT_NODE_A_EXTRA_FLAGS=
OUTPUT_SRT_NODE_B_EXTRA_FLAGS=
OUTPUT_SRT_OUTPUT_EXTRA_FLAGS=--multiple --transtype live --messageapi
NODE_A_HOST=127.0.0.1
NODE_A_PORT=7001
NODE_B_HOST=127.0.0.1
NODE_B_PORT=7002
OUTPUT_FAILOVER_OUTPUT_LISTEN_PORT=8000
OUTPUT_FAILOVER_RECEIVE_TIMEOUT_MS=2000
TSSWITCH_REMOTE_HOST=127.0.0.1
TSSWITCH_REMOTE_PORT=4444
TSSWITCH_ALLOW_HOST=127.0.0.1
TSSWITCH_EVENT_UDP_HOST=127.0.0.1
TSSWITCH_EVENT_UDP_PORT=5556
OUTPUT_FAILOVER_VERBOSE=1
OUTPUT_SRT_STATS_INTERVAL_MS=5000
# Optional bridge connectors (profile: bridge-connectors):
# bridge-a pulls from processing node A and forwards to gateway leg A.
# bridge-b pulls from processing node B and forwards to gateway leg B.
# The bridge script supports either generic BRIDGE_SOURCE_*/BRIDGE_TARGET_*
# vars or keyed BRIDGE_A_*/BRIDGE_B_* vars (used by compose profile by default).
BRIDGE_VERBOSE=1
BRIDGE_SRT_COMMON_FLAGS=--transtype live --messageapi
BRIDGE_A_SOURCE_HOST=127.0.0.1
BRIDGE_A_SOURCE_PORT=7101
BRIDGE_A_SOURCE_EXTRA_FLAGS=
BRIDGE_A_TARGET_HOST=127.0.0.1
BRIDGE_A_TARGET_PORT=7001
BRIDGE_A_TARGET_EXTRA_FLAGS=
BRIDGE_B_SOURCE_HOST=127.0.0.1
BRIDGE_B_SOURCE_PORT=7102
BRIDGE_B_SOURCE_EXTRA_FLAGS=
BRIDGE_B_TARGET_HOST=127.0.0.1
BRIDGE_B_TARGET_PORT=7002
BRIDGE_B_TARGET_EXTRA_FLAGS=

# -----------------------------------------------------------------------------
# Watchdog / observer common
# -----------------------------------------------------------------------------
WATCHDOG_ENABLE_HEALTH_POLLING=true
WATCHDOG_ENABLE_SWITCH_COMMANDS=true
WATCHDOG_INITIAL_ACTIVE_INPUT=0
WATCHDOG_POLL_INTERVAL_SEC=1.0
WATCHDOG_HEALTH_TIMEOUT_SEC=1.5
WATCHDOG_GOOD_THRESHOLD=3
WATCHDOG_BAD_THRESHOLD=3
WATCHDOG_WAITING_FLAP_WINDOW_SEC=8.0
WATCHDOG_WAITING_FLAP_THRESHOLD=3
WATCHDOG_EVENT_LISTEN_HOST=0.0.0.0
WATCHDOG_EVENT_LISTEN_PORT=5556
WATCHDOG_METRICS_HOST=0.0.0.0
WATCHDOG_METRICS_PORT=9108

# Input observer defaults
INPUT_OBSERVER_EVENT_LISTEN_HOST=0.0.0.0
INPUT_OBSERVER_METRICS_HOST=0.0.0.0
INPUT_OBSERVER_METRICS_PORT=9107

# Output watchdog health endpoints
NODE_A_HEALTH_URL=http://127.0.0.1:18081/health
NODE_B_HEALTH_URL=http://127.0.0.1:18082/health
# Optional content-based health rules (regex against response body).
# Use *_HEALTH_OK_REGEX to require a matching marker in 2xx responses.
# Use *_HEALTH_FAIL_REGEX to fail when a marker appears in 2xx responses.
# Example for metrics endpoints:
# NODE_A_HEALTH_URL=http://127.0.0.1:8080/v1/metrics
# NODE_A_HEALTH_OK_REGEX=(?m)^pixop_system_status 0$
# NODE_A_HEALTH_FAIL_REGEX=(?m)^pixop_system_status [12]$
NODE_A_HEALTH_OK_REGEX=
NODE_A_HEALTH_FAIL_REGEX=
NODE_B_HEALTH_OK_REGEX=
NODE_B_HEALTH_FAIL_REGEX=
MOCK_HEALTH_TOKEN=devtoken

# OpenTelemetry
OTEL_ENABLED=true
OTEL_SERVICE_NAME=srt-redundancy-watchdog
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318/v1/traces
