# -----------------------------------------------------------------------------
# Input failover gateway
# -----------------------------------------------------------------------------
PRIMARY_LISTEN_PORT=5000
BACKUP_LISTEN_PORT=5010
INPUT_FAILOVER_OUTPUT_LISTEN_PORT=6000
INPUT_FAILOVER_RECEIVE_TIMEOUT_MS=2000
INPUT_FAILOVER_VERBOSE=1

# -----------------------------------------------------------------------------
# Output failover gateway
# -----------------------------------------------------------------------------
NODE_A_HOST=127.0.0.1
NODE_A_PORT=7001
NODE_B_HOST=127.0.0.1
NODE_B_PORT=7002
OUTPUT_FAILOVER_OUTPUT_LISTEN_PORT=8000
OUTPUT_FAILOVER_RECEIVE_TIMEOUT_MS=2000
TSSWITCH_REMOTE_HOST=127.0.0.1
TSSWITCH_REMOTE_PORT=4444
TSSWITCH_ALLOW_HOST=127.0.0.1
TSSWITCH_EVENT_UDP_HOST=127.0.0.1
TSSWITCH_EVENT_UDP_PORT=5556
OUTPUT_FAILOVER_VERBOSE=1

# -----------------------------------------------------------------------------
# Watchdog
# -----------------------------------------------------------------------------
NODE_A_HEALTH_URL=http://127.0.0.1:18081/health
NODE_B_HEALTH_URL=http://127.0.0.1:18082/health
MOCK_HEALTH_TOKEN=devtoken
WATCHDOG_POLL_INTERVAL_SEC=1.0
WATCHDOG_HEALTH_TIMEOUT_SEC=1.5
WATCHDOG_GOOD_THRESHOLD=3
WATCHDOG_BAD_THRESHOLD=3
WATCHDOG_INITIAL_ACTIVE_INPUT=0

# Metrics & observability
WATCHDOG_METRICS_HOST=0.0.0.0
WATCHDOG_METRICS_PORT=9108
WATCHDOG_EVENT_LISTEN_HOST=0.0.0.0
WATCHDOG_EVENT_LISTEN_PORT=5556
OTEL_ENABLED=true
OTEL_SERVICE_NAME=srt-redundancy-watchdog
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318/v1/traces
# Shared / image behavior
LOG_LEVEL=INFO
COMMAND_DEBUG=true

# Input failover gateway defaults
PRIMARY_LISTEN_PORT=5000
BACKUP_LISTEN_PORT=5010
INPUT_OUTPUT_LISTEN_PORT=6000
INPUT_RECEIVE_TIMEOUT_MS=2000
INPUT_PRIMARY_INDEX=0
INPUT_FAST_SWITCH=true
INPUT_INFINITE=true
SRT_COMMON_FLAGS=--multiple --transtype live --messageapi

# Output failover gateway defaults
NODE_A_HOST=127.0.0.1
NODE_A_PORT=7001
NODE_B_HOST=127.0.0.1
NODE_B_PORT=7002
OUTPUT_LISTEN_PORT=8000
OUTPUT_RECEIVE_TIMEOUT_MS=2000
OUTPUT_PRIMARY_INDEX=0
OUTPUT_FAST_SWITCH=true
OUTPUT_INFINITE=true
TSSWITCH_REMOTE_HOST=127.0.0.1
TSSWITCH_REMOTE_PORT=4444
TSSWITCH_ALLOW_HOST=127.0.0.1
TSSWITCH_EVENT_UDP_TARGET=127.0.0.1:4545
TSSWITCH_EVENT_USER_DATA=output-failover

# Watchdog behavior
WATCHDOG_NODE_A_URL=http://127.0.0.1:18081/health
WATCHDOG_NODE_B_URL=http://127.0.0.1:18082/health
WATCHDOG_HTTP_TIMEOUT_SECONDS=1.5
WATCHDOG_POLL_INTERVAL_SECONDS=1.0
WATCHDOG_GOOD_THRESHOLD=2
WATCHDOG_BAD_THRESHOLD=3
WATCHDOG_INITIAL_INPUT=0
WATCHDOG_ENABLE_EVENT_LISTENER=true
WATCHDOG_EVENT_LISTEN_HOST=0.0.0.0
WATCHDOG_EVENT_LISTEN_PORT=4545
WATCHDOG_METRICS_HOST=0.0.0.0
WATCHDOG_METRICS_PORT=9108

# OpenTelemetry (optional)
OTEL_ENABLED=false
OTEL_SERVICE_NAME=srt-redundancy-watchdog
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_EXPORTER_OTLP_INSECURE=true
