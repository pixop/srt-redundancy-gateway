# -----------------------------------------------------------------------------
# Docker Hub release configuration
# Copy to scripts/release.env and edit values.
# -----------------------------------------------------------------------------

# Your Docker Hub namespace (user or org).
DOCKER_NAMESPACE=your-dockerhub-namespace

# Image names (without namespace).
TSDUCK_IMAGE_NAME=srt-redundancy-gateway-tsduck
WATCHDOG_IMAGE_NAME=srt-redundancy-gateway-watchdog
TSDUCK_TOOLS_IMAGE_NAME=srt-redundancy-gateway-tsduck-tools

# Release tag (example: v0.1.0).
RELEASE_TAG=v0.1.0

# Optional short git SHA tag, useful for traceability.
# Set to empty to skip.
GIT_SHA_TAG=

# Push a "latest" tag in addition to RELEASE_TAG.
PUSH_LATEST=false

# Docker buildx platforms.
PLATFORMS=linux/amd64,linux/arm64

# TSDuck source tag used by the tsduck-tools Dockerfile.
TSDUCK_TAG=v3.43-4549

# Build from workspace root by default.
PROJECT_ROOT=.
